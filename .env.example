# Next.js / Clerk -- configure from Clerk dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_CONVEX_URL=https://REPLACE_ME.convex.cloud
# Clerk -> Convex token template issuer (set as Convex auth environment variable)
# CLERK_JWT_ISSUER_DOMAIN=https://YOUR_CLERK_FRONTEND_API

# Convex dashboard environment variables (DO NOT put shared secrets in NEXT_PUBLIC_*)
# N8N_WEBHOOK_URL=https://YOUR_N8N_HOST/webhook/lendloop-events
# N8N_WEBHOOK_SECRET=generate_a_random_32_plus_byte_secret
# N8N_CALLBACK_TOKEN=generate_a_different_random_32_plus_byte_token
# ADMIN_CLERK_ID=user_REPLACE_ME

# Docker Compose / n8n environment (copy to a separate local .env)
N8N_ENCRYPTION_KEY=generate_a_random_32_plus_byte_key
LENDLOOP_WEBHOOK_SECRET=use_the_same_value_as_N8N_WEBHOOK_SECRET
LENDLOOP_CALLBACK_TOKEN=use_the_same_value_as_N8N_CALLBACK_TOKEN
LENDLOOP_CONVEX_SITE_URL=https://REPLACE_ME.convex.site
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PORT=5678
